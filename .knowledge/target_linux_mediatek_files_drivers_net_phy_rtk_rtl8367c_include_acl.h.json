{"is_source_file": true, "format": "C header file", "description": "This file defines the data structures, constants, enums, and function prototypes for the High-Level API of the RTL8367/RTL8367C switch's ACL (Access Control List) module. It includes types for ACL rules, filter fields, actions, and associated configuration functions, primarily used to manage and configure ACL rules, filtering, and matching behavior on the switch hardware.", "external_files": ["rtk_types.h", "rtk_port.h", "rtk_api.h", "rtk_mac.h", "rtk_macro.h"], "external_methods": ["rtk_filter_igrAcl_init", "rtk_filter_igrAcl_field_add", "rtk_filter_igrAcl_cfg_add", "rtk_filter_igrAcl_cfg_del", "rtk_filter_igrAcl_cfg_delAll", "rtk_filter_igrAcl_cfg_get", "rtk_filter_igrAcl_unmatchAction_set", "rtk_filter_igrAcl_unmatchAction_get", "rtk_filter_igrAcl_state_set", "rtk_filter_igrAcl_state_get", "rtk_filter_igrAcl_template_set", "rtk_filter_igrAcl_template_get", "rtk_filter_igrAcl_field_sel_set", "rtk_filter_igrAcl_field_sel_get", "rtk_filter_iprange_set", "rtk_filter_iprange_get", "rtk_filter_vidrange_set", "rtk_filter_vidrange_get", "rtk_filter_portrange_set", "rtk_filter_portrange_get", "rtk_filter_igrAclPolarity_set", "rtk_filter_igrAclPolarity_get"], "published": ["RTK_API_ACL_H", "rtk_filter_cfg_t", "rtk_filter_action_t", "rtk_filter_field_t", "rtk_filter_cfg_raw_t", "rtk_filter_template_t", "rtk_filter_unmatch_action_t", "rtk_filter_state_t"], "classes": [], "methods": [{"name": "rtk_filter_igrAcl_init", "description": "Initializes the ACL subsystem, enabling and setting up the ACL hardware and data structures."}, {"name": "rtk_filter_igrAcl_field_add", "description": "Adds a comparison rule to an existing ACL configuration, appending to the linked list of rules."}, {"name": "rtk_filter_igrAcl_cfg_add", "description": "Stores an ACL configuration and associated actions into the ASIC starting at a specified filter ID."}, {"name": "rtk_filter_igrAcl_cfg_del", "description": "Deletes an ACL configuration from the ASIC starting at the specified filter ID."}, {"name": "rtk_filter_igrAcl_cfg_delAll", "description": "Removes all ACL configurations from the ASIC."}, {"name": "rtk_filter_igrAcl_cfg_get", "description": "Retrieves a specific ACL configuration and its associated action from the ASIC by index."}, {"name": "rtk_filter_igrAcl_unmatchAction_set", "description": "Sets the action taken when a packet does not match any ACL rule on a specific port."}, {"name": "rtk_filter_igrAcl_unmatchAction_get", "description": "Gets the current unmatch action configuration for a specific port."}, {"name": "rtk_filter_igrAcl_state_set", "description": "Enables or disables ingress ACL on a specific port."}, {"name": "rtk_filter_igrAcl_state_get", "description": "Retrieves the current state (enabled/disabled) of ingress ACL on a specific port."}, {"name": "rtk_filter_igrAcl_template_set", "description": "Sets the template used for ACL rule matching criteria."}, {"name": "rtk_filter_igrAcl_template_get", "description": "Gets the current ACL rule template configuration."}, {"name": "rtk_filter_igrAcl_field_sel_set", "description": "Configures a user-defined field selector in the hardware for custom packet matching."}, {"name": "rtk_filter_igrAcl_field_sel_get", "description": "Retrieves the current configuration of a user-defined field selector."}, {"name": "rtk_filter_iprange_set", "description": "Defines an IP range check rule in the ACL engine."}, {"name": "rtk_filter_iprange_get", "description": "Retrieves an IP range check rule configuration."}, {"name": "rtk_filter_vidrange_set", "description": "Sets a VLAN ID range check rule in the ACL."}, {"name": "rtk_filter_vidrange_get", "description": "Gets the current VLAN ID range check rule."}, {"name": "rtk_filter_portrange_set", "description": "Defines a port number range check rule."}, {"name": "rtk_filter_portrange_get", "description": "Retrieves a port range check rule configuration."}, {"name": "rtk_filter_igrAclPolarity_