ount for UBUS context.", "scope": "", "scopeKind": ""}, {"name": "void wpas_ubus_ref_dec(void)", "description": "Decrements the reference count for UBUS context and frees it if count reaches zero.", "scope": "", "scopeKind": ""}, {"name": "int wpas_bss_get_features(struct ubus_context * ctx,struct ubus_object * obj,struct ubus_request_data * req,const char * method,struct blob_attr * msg)", "description": "Handles UBUS request to get features supported by the BSS.", "scope": "", "scopeKind": ""}, {"name": "int wpas_bss_reload(struct ubus_context * ctx,struct ubus_object * obj,struct ubus_request_data * req,const char * method,struct blob_attr * msg)", "description": "Handles UBUS request to reload the wpa_supplicant configuration.", "scope": "", "scopeKind": ""}, {"name": "int wpas_bss_wps_start(struct ubus_context * ctx,struct ubus_object * obj,struct ubus_request_data * req,const char * method,struct blob_attr * msg)", "description": "Starts WPS process via UBUS command.", "scope": "", "scopeKind": ""}, {"name": "int wpas_bss_wps_cancel(struct ubus_context * ctx,struct ubus_object * obj,struct ubus_request_data * req,const char * method,struct blob_attr * msg)", "description": "Cancels WPS process via UBUS command.", "scope": "", "scopeKind": ""}, {"name": "void wpas_ubus_add_bss(struct wpa_supplicant * wpa_s)", "description": "Adds a BSS object to UBUS for a specific wpa_supplicant instance.", "scope": "", "scopeKind": ""}, {"name": "void wpas_ubus_free_bss(struct wpa_supplicant * wpa_s)", "description": "Removes the UBUS BSS object for a wpa_supplicant instance.", "scope": "", "scopeKind": ""}, {"name": "void wpas_ubus_notify(struct wpa_supplicant * wpa_s,const struct wps_credential * cred)", "description": "Sends notifications about WPS credentials over UBUS.", "scope": "", "scopeKind": ""}], "calls": ["ubus_connect", "ubus_add_uloop", "ubus_free", "ubus_send_reply", "ubus_add_object", "ubus_remove_object", "ubus_send_event", "eloop_register_timeout", "uloop_fd