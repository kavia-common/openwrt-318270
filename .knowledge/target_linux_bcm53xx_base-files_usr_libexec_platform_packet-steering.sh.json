{"is_source_file": true, "format": "shell script", "description": "This file manages packet steering and flow offloading configurations for network interfaces on an OpenWrt-based system. It uses UCI commands to retrieve configuration values and sets CPU packet processing affinities accordingly.", "external_files": ["uci"], "external_methods": ["uci -q get"], "published": [], "classes": [], "methods": [], "calls": ["uci -q get network.@globals[0].packet_steering", "uci -q get firewall.@defaults[0].flow_offloading", "uci -q get firewall.@defaults[0].flow_offloading_hw", "echo 0 > /sys/class/net/br-lan/queues/rx-0/rps_cpus", "echo 0 > /sys/class/net/eth0/queues/rx-0/rps_cpus", "echo 2 > /sys/class/net/eth0/queues/rx-0/rps_cpus", "echo 2 > /sys/class/net/br-lan/queues/rx-0/rps_cpus"], "search-terms": ["packet steering", "flow offloading", "openwrt", "shell script", "rps_cpus", "uci"], "state": 2, "file_id": 847, "knowledge_revision": 2218, "git_revision": "56a93f98738acd029c88e50de07911101746e565", "hash": "c4654500c03184fdbd6aaacab6fb914e", "format-version": 4, "code-base-name": "openwrt-318270", "filename": "target/linux/bcm53xx/base-files/usr/libexec/platform/packet-steering.sh", "revision_history": [{"2218": "56a93f98738acd029c88e50de07911101746e565"}]}