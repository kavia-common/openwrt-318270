{"is_source_file": true, "format": "Perl", "description": "This file is a Perl script for handling downloads within the OpenWrt build system. It manages downloading files from various mirrors, verifies hashes, and supports multiple download tools like wget, curl, and aria2c. The script includes functions for mirror management, command selection, and download execution, indicating it is a utility script rather than a typical source code module.", "external_files": ["$scriptdir/localmirrors", "$ENV{'TOPDIR'}/.config"], "external_methods": ["command -v", "system", "open", "close", "readline", "copy"], "published": [], "classes": [], "methods": [], "calls": ["command -v", "system(\"mkdir\", \"-p\", \"$target/\")", "system(\"find $mirror -follow -name $filename 2>/dev/null |\")", "open LM, \"$scriptdir/localmirrors\"", "close LM", "open CONFIG, \"<\".$ENV{'TOPDIR'}.\"/.config\"", "close CONFIG", "open TOOL, \"$tool_name --version 2>/dev/null |\"", "close TOOL", "system(\"cat '$target/$filename.hash'\")", "unlink", "copy", "open TMPDLS, \"find $mirror -follow -name $filename 2>/dev/null |\"", "readline TMPDLS", "readline TOOL", "open MD5SUM, \"| $hash_cmd > '$target/$filename.hash'\"", "open OUTPUT, \"> $target/$filename.dl\"", "close MD5SUM", "close OUTPUT", "system", "read FETCH_FD, $buffer, 1048576", "unlink", "mv", "close FETCH_FD"], "search-terms": ["download", "mirrors", "hash", "tools", "aria2c", "wget", "curl", "OpenWrt"], "state": 2, "file_id": 102, "knowledge_revision": 1497, "git_revision": "4df592f7a34166a57dab2ab7570ce3fe2ebd3118", "hash": "82d1586e79bee7d62c0a705231355572", "format-version": 4, "code-base-name": "openwrt-318270", "filename": "scripts/download.pl", "revision_history": [{"1497": "4df592f7a34166a57dab2ab7570ce3fe2ebd3118"}]}