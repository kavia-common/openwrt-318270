{"is_source_file": true, "format": "shell script", "description": "This file contains a shell script for configuring packet steering and receive packet steering (RPS) CPU affinity settings on a Linux system, specifically tailored for the OpenWrt platform using UCI configuration tools.", "external_files": ["/usr/libexec/platform/packet-steering.sh"], "external_methods": ["uci -q get", "grep -c", "echo"], "published": [], "classes": [], "methods": [], "calls": ["uci -q get network.@globals[0].packet_steering", "grep -c \"^processor.*:\" /proc/cpuinfo", "uci -q get firewall.@defaults[0].flow_offloading", "uci -q get firewall.@defaults[0].flow_offloading_hw", "echo $rps_eth0 > /sys/class/net/eth0/queues/rx-0/rps_cpus", "echo $rps_br_lan > /sys/class/net/br-lan/queues/rx-0/rps_cpus"], "search-terms": ["packet steering", "RPS configuration", "OpenWrt", "linux network optimization", "cpu affinity"], "state": 2, "file_id": 819, "knowledge_revision": 2212, "git_revision": "f06bd5bdb8e131a566d0f0068835296112f69915", "hash": "8587872fcfdfc15c6e10b3a9b1473db6", "format-version": 4, "code-base-name": "openwrt-318270", "filename": "target/linux/bcm4908/base-files/usr/libexec/platform/packet-steering.sh", "revision_history": [{"2212": "f06bd5bdb8e131a566d0f0068835296112f69915"}]}