From: OpenWrt Developers
Subject: net: add swconfig switch drivers support

Add support for swconfig-based managed switch configuration,
used by many embedded devices.

Signed-off-by: OpenWrt Developers
---
 drivers/net/phy/Kconfig  | 10 ++++++++++
 drivers/net/phy/Makefile |  1 +
 2 files changed, 11 insertions(+)

--- a/drivers/net/phy/Kconfig
+++ b/drivers/net/phy/Kconfig
@@ -46,6 +46,16 @@ config SFP
 	depends on HWMON || HWMON=n
 	select MDIO_I2C
 
+config SWCONFIG
+	tristate "Switch configuration API"
+	help
+	  Switch configuration API for configuring managed switches
+	  using a unified interface. This is used by many embedded
+	  platforms with managed switch hardware.
+
+	  To compile this as a module, choose M here: the
+	  module will be called swconfig.
+
 comment "Switch configuration API + drivers"
 
 config PHYLINK
--- a/drivers/net/phy/Makefile
+++ b/drivers/net/phy/Makefile
@@ -20,6 +20,7 @@ libphy-$(CONFIG_LED_TRIGGER_PHY)	+= phy_
 
 obj-$(CONFIG_PHYLINK)		+= phylink.o
 obj-$(CONFIG_PHYLIB)		+= libphy.o
+obj-$(CONFIG_SWCONFIG)		+= swconfig.o
 
 obj-$(CONFIG_NETWORK_PHY_TIMESTAMPING) += mii_timestamper.o
